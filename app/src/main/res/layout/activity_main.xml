<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_split_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/rewards_green">

        <LinearLayout
            android:id="@+id/rewards_scanner_panel"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@color/rewards_green"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rewards_headline"
                android:textColor="@color/rewards_cream"
                android:textStyle="bold"
                android:textSize="27sp"
                android:gravity="center"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/rewards_subtitle"
                android:textColor="#DDF4EDDF"
                android:textSize="15sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:background="@drawable/rewards_phone_frame">

                    <TextureView
                        android:id="@+id/wallet_tutorial_video"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/wallet_rewards_tutorial_poster"
                        android:contentDescription="@string/wallet_tutorial_description"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="4dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="#D9101820"
                        android:text="@string/example_wallet"
                        android:textColor="@color/rewards_cream"
                        android:textStyle="bold"
                        android:textSize="8sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="9dp"
                    android:padding="4dp"
                    android:background="@drawable/rewards_camera_frame">

                    <com.journeyapps.barcodescanner.DecoratedBarcodeView
                        android:id="@+id/inline_rewards_scanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:padding="8dp"
                        android:gravity="center"
                        android:background="#D9101820"
                        android:text="@string/camera_guide"
                        android:textColor="@color/rewards_cream"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_flip_inline_camera"
                        android:layout_width="48dp"
                        android:layout_height="42dp"
                        android:layout_gravity="top|end"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:backgroundTint="@color/rewards_cream"
                        android:textColor="@color/rewards_green"
                        android:text="↻"
                        android:textSize="22sp"
                        android:contentDescription="@string/flip_camera" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tap_action_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rewards_action_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NFC  •  TAP CARD"
                        android:textColor="@color/rewards_green"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_instruction"
                        android:textColor="#704B2D20"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rewards_action_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▦  •  SHOW QR"
                        android:textColor="@color/rewards_green"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qr_instruction"
                        android:textColor="#704B2D20"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/rewards_scanner_status"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/rewards_status_pill"
                android:text="@string/scanner_ready"
                android:textColor="@color/rewards_cream"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="2"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/loading_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="28dp"
        android:background="@color/rewards_green"
        android:textColor="@color/rewards_cream"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:src="@android:drawable/ic_menu_manage"
        android:background="@android:color/transparent"
        android:contentDescription="@string/settings"
        android:alpha="0.42" />

    <TextView
        android:id="@+id/nfc_tap_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#DD101820"
        android:textColor="@color/rewards_cream"
        android:textStyle="bold"
        android:textSize="28sp"
        android:text="Reading rewards card…"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nfc_reader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:background="#EE173F2F"
        android:textColor="@color/rewards_success"
        android:textStyle="bold"
        android:textSize="32sp"
        android:text="Wallet connected\nYou’re ready to earn rewards"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
