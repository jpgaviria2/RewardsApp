<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_split_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#173F2F">

        <LinearLayout
            android:id="@+id/rewards_scanner_panel"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:orientation="vertical"
            android:background="#101820"
            android:visibility="gone">

            <com.journeyapps.barcodescanner.DecoratedBarcodeView
                android:id="@+id/inline_rewards_scanner"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="#E6173F2F">

                <TextView
                    android:id="@+id/rewards_scanner_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan wallet Lightning address QR"
                    android:textColor="#F4EDDF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/btn_flip_inline_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:backgroundTint="#F4EDDF"
                    android:textColor="#173F2F"
                    android:text="Flip"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/loading_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#173F2F"
        android:textColor="#F4EDDF"
        android:textSize="20sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:src="@android:drawable/ic_menu_manage"
        android:background="@android:color/transparent"
        android:contentDescription="Settings"
        android:alpha="0.28" />

    <TextView
        android:id="@+id/nfc_tap_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:text="📡 Tap detected!"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nfc_reader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#CC1B5E20"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:text="✅ Reward Credited!"
        android:visibility="gone" />
</FrameLayout>