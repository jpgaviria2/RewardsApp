<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/main_split_layout"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/rewards_green">
        <Button android:id="@+id/btn_customer_rewards"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="Customer rewards"
            android:textSize="22sp" android:textStyle="bold" android:textColor="@color/rewards_green" />

        <!-- Retain the existing camera decoder, not an additional customer card. -->
        <LinearLayout android:id="@+id/rewards_scanner_panel"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:orientation="vertical" android:visibility="gone">

            <Button android:id="@+id/btn_flip_inline_camera"
                android:layout_width="48dp" android:layout_height="48dp"
                android:visibility="gone" android:contentDescription="@string/flip_camera" />
        </LinearLayout>

        <FrameLayout android:id="@+id/customer_content"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <!-- Existing camera decoder stays laid out behind opaque server content.
                 HID admission still does not depend on camera permission or startup. -->
            <com.journeyapps.barcodescanner.DecoratedBarcodeView
                android:id="@+id/inline_rewards_scanner"
                android:layout_width="match_parent" android:layout_height="match_parent" />
            <!-- Server remains authoritative for waiting / checked-in / reward content. -->
            <WebView android:id="@+id/webview"
                android:layout_width="match_parent" android:layout_height="match_parent" />
            <!-- Retained controller targets are dormant; no competing tutorial card. -->
            <LinearLayout android:id="@+id/idle_tutorial_panel"
                android:layout_width="0dp" android:layout_height="0dp"
                android:orientation="vertical" android:visibility="gone">
                <FrameLayout android:id="@+id/wallet_tutorial_frame"
                    android:layout_width="1dp" android:layout_height="1dp">
                    <TextureView android:id="@+id/wallet_tutorial_video"
                        android:layout_width="1dp" android:layout_height="1dp"
                        android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/wallet_tutorial_poster"
                        android:layout_width="1dp" android:layout_height="1dp"
                        android:src="@drawable/wallet_rewards_tutorial_poster"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
            <TextView android:id="@+id/rewards_scanner_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:padding="12dp"
                android:background="@color/rewards_green" android:textColor="@color/rewards_cream"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/nfc_tap_overlay"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="24dp"
                android:background="@color/rewards_cream" android:textColor="@color/rewards_green"
                android:textStyle="bold" android:textSize="28sp"
                android:clickable="true" android:focusable="true" android:visibility="gone" />
            <TextView android:id="@+id/nfc_reader_overlay"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="24dp"
                android:background="@color/rewards_cream" android:textColor="@color/rewards_green"
                android:textStyle="bold" android:textSize="32sp"
                android:clickable="true" android:focusable="true" android:visibility="gone" />
            <com.bitcoinrewards.nfcdisplay.CheckInConfettiView android:id="@+id/check_in_confetti"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clickable="false" android:focusable="false"
                android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        <Button android:id="@+id/btn_collect_payment"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Take payment" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/loading_text"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="28dp"
        android:background="@color/rewards_green" android:textColor="@color/rewards_cream"
        android:textSize="20sp" android:textStyle="bold" android:visibility="gone" />
    <ImageButton android:id="@+id/btn_settings"
        android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end"
        android:src="@android:drawable/ic_menu_manage" android:background="@android:color/transparent"
        android:contentDescription="@string/settings" android:alpha="0.42" />
</FrameLayout>
