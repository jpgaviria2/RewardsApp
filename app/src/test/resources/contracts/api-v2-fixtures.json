{
  "contract": "bitcoin-rewards-check-in-v2",
  "protocolVersion": 2,
  "tokenGenerationSemantics": "client-local scoped-token generation; correlation-only; echoed exactly; never used as server authentication authority",
  "checkInIdSemantics": "client-issued UUID persisted before transmission; server creates idempotently and rejects a conflicting replay",
  "confirmationVersionSemantics": "server-issued optimistic version; echo exactly; increments when Pending is claimed for confirm or cancel; stale same-action retries receive current durable state",
  "fixtures": [
    {
      "name": "check-in",
      "method": "POST",
      "path": "/plugins/bitcoin-rewards/store/check-in/api/v2",
      "request": {"deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","protocolVersion":2},
      "response": {"status":"PENDING","storeId":"store","deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","protocolVersion":2}
    },
    {
      "name": "poll-awaiting-confirmation",
      "method": "GET",
      "path": "/plugins/bitcoin-rewards/store/check-in/api/v2/check-ins/11111111-1111-4111-8111-111111111111?deviceId=device&tokenGeneration=4&protocolVersion=2",
      "response": {"status":"AWAITING_CONFIRMATION","storeId":"store","deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":1,"protocolVersion":2,"amountSatoshis":321,"destinationLabel":"a***@example.com"}
    },
    {
      "name": "confirm",
