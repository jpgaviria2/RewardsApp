      "response": {"status":"PAID","storeId":"store","deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":2,"protocolVersion":2,"resultCode":"paid","payoutState":"PAID"}
