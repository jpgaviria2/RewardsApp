      "path": "/plugins/bitcoin-rewards/store/check-in/api/v2/confirmations/22222222-2222-4222-8222-222222222222/confirm",
      "request": {"deviceId":"device","tokenGeneration":4,"checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":1,"protocolVersion":2},
      "response": {"status":"CONFIRMING","storeId":"store","deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":2,"protocolVersion":2,"resultCode":"dispatching","payoutState":"PAYING"}
    },
    {
      "name": "cancel",
      "method": "POST",
      "path": "/plugins/bitcoin-rewards/store/check-in/api/v2/confirmations/22222222-2222-4222-8222-222222222222/cancel",
      "request": {"deviceId":"device","tokenGeneration":4,"checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":1,"protocolVersion":2},
      "response": {"status":"CANCELLED","storeId":"store","deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":2,"protocolVersion":2,"resultCode":"cancelled","payoutState":null}
    },
    {
      "name": "ambiguous",
      "method": "GET",
      "path": "/plugins/bitcoin-rewards/store/check-in/api/v2/check-ins/11111111-1111-4111-8111-111111111111?deviceId=device&tokenGeneration=4&protocolVersion=2",
      "response": {"status":"AMBIGUOUS","storeId":"store","deviceId":"device","tokenGeneration":4,"destination":"alice@example.com","checkInId":"11111111-1111-4111-8111-111111111111","confirmationId":"22222222-2222-4222-8222-222222222222","confirmationVersion":2,"protocolVersion":2,"resultCode":"reconciliation_required","payoutState":"MANUAL_REVIEW"}
    },
